# Runtime CMS data — keep folder markers only (never commit JSON / hashes / secrets)
data/**
!data/.gitkeep
!data/.htaccess
!data/mail/
data/mail/**
!data/mail/.gitkeep
!data/mail/.htaccess

# Never commit credentials / password material (belt-and-suspenders)
**/.admin_password_hash
**/users.json
**/.mail_inbound_secret
**/.env
**/.env.*
!**/.env.example
**/.dev.vars
**/credentials.json

# Uploaded media (runtime) — keep folder markers only
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# Deploy packs from tools/pack-deploy.php
auburn-vsa-deploy.zip
auburn-vsa-deploy-*.zip

# Local portable Node (ops helper; not shipped)
tools/.node/

# Wrangler local state for the mail worker (contains Cloudflare account id/email)
workers/**/.wrangler/
workers/**/node_modules/
workers/**/.dev.vars

# Local scratch / captures (not part of the live site)
_ui_*.png

# Developer-private recovery service (randomized local route; never deploy/commit)
/svc-????????????????/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
